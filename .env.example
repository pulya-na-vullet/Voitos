# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=*
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@localhost

# Server — 0.0.0.0 = доступен всем устройствам в той же Wi‑Fi сети
HOST=0.0.0.0
PORT=18765

# Если стенд уже в интернете/на VPS — укажите публичный URL (без /panel/):
# PANEL_PUBLIC_URL=https://voitos.example.com
# Если пусто — в MAX уходит http://LAN_IP:PORT/panel/login/ + пометка про Wi‑Fi ИТ-Мастерской

# Optional overrides (also configurable in admin panel)
# MAX_BOT_TOKEN=
# MAX_BOT_OPEN_URL=https://max.ru/your_bot
# AUTH_BOT_INTERNAL_TOKEN=
# ALLOWED_MAX_USER_ID=
# YANDEX_API_KEY=
# YANDEX_FOLDER_ID=
# YANDEX_MODEL=yandexgpt-lite

# MAX TLS: platform-api2.max.ru uses Минцифры certificates.
# Voitos ships them in certs/. Keep true unless you hit SSL errors on Windows.
MAX_SSL_VERIFY=true
# MAX_SSL_CA_BUNDLE=

# Mobile / FCM (Legacy server key). Пусто + FCM_DRY_RUN=true — только лог.
# FCM_SERVER_KEY=
FCM_DRY_RUN=true
MOBILE_OTP_DEBUG=true
